NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# SMS — Arkesel (https://arkesel.com)
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=

# AI — Groq free tier (https://console.groq.com)
GROQ_API_KEY=

# Bot protection — Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Create a Turnstile widget for this domain and put the real site/secret keys here.
# For local development only, Cloudflare publishes test keys that always pass:
# site key  1x00000000000000000000AA
# secret key 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Error monitoring — Sentry (https://sentry.io)
# Leave blank locally so dev noise never reaches the real project.
# SENTRY_AUTH_TOKEN is only needed for readable (un-minified) stack
# traces in the dashboard — error capture itself works without it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
